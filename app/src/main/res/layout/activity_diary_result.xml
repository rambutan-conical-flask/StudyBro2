<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E1EBF3"
    android:padding="24dp">

    <!-- 顶部标题 -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Good luck"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_centerHorizontal="true" />

    <!-- 左侧圆形心情图（先做成方形，后面可以再加圆形裁剪） -->
    <ImageView
        android:id="@+id/imageMoodResult"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_below="@id/textTitle"
        android:layout_marginTop="24dp"
        android:layout_alignParentStart="true"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle_white" />

    <!-- 右侧用户文本内容 -->
    <TextView
        android:id="@+id/textDiaryContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imageMoodResult"
        android:layout_alignTop="@id/imageMoodResult"
        android:layout_marginStart="16dp"
        android:background="@android:color/white"
        android:padding="16dp"
        android:textColor="#000000"
        android:textSize="16sp" />

    <!-- AI 返回的文本 -->
    <TextView
        android:id="@+id/textAiReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textDiaryContent"
        android:layout_marginTop="24dp"
        android:background="@android:color/white"
        android:padding="16dp"
        android:textColor="#000000"
        android:textSize="16sp"
        android:text="AI is generating suggestions for you..." />

    <Button
        android:id="@+id/buttonHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HISTORY"
        android:layout_below="@+id/textAiReply"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/buttonToMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BACK"
        android:layout_below="@+id/buttonHistory"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

</RelativeLayout>
